<Window x:Class="Shop.Presentation.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إنشاء حساب جديد" Height="340" Width="420" FlowDirection="RightToLeft">
    <Grid Margin="12">
        <StackPanel Width="360" HorizontalAlignment="Center">
            <TextBlock Text="إنشاء حساب جديد" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" />

            <TextBlock Text="اسم المستخدم" />
            <TextBox x:Name="UsernameBox" />

            <TextBlock Text="البريد الإلكتروني" Margin="0,8,0,0" />
            <TextBox x:Name="EmailBox" />

            <TextBlock Text="كلمة السر" Margin="0,8,0,0" />
            <PasswordBox x:Name="PasswordBox" />

            <TextBlock Text="تأكيد كلمة السر" Margin="0,8,0,0" />
            <PasswordBox x:Name="ConfirmPasswordBox" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock Text="الصلاحية:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="RoleCombo" Width="160" VerticalAlignment="Center">
                    <ComboBoxItem Content="Owner" />
                    <ComboBoxItem Content="Partner" />
                    <ComboBoxItem Content="Employee" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="CreateBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/icon_user.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="إنشاء" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Width="120" Click="CancelBtn_Click">إلغاء</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
