<Window x:Class="Shop.Presentation.AddMerchantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة تاجر" Height="260" Width="420" FlowDirection="RightToLeft">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="اسم التاجر" />
            <TextBox x:Name="NameBox" Height="30" />
            <TextBlock Text="الهاتف" Margin="0,8,0,0" />
            <TextBox x:Name="PhoneBox" Height="30" />
            <TextBlock Text="المكان" Margin="0,8,0,0" />
            <TextBox x:Name="LocationBox" Height="30" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Width="120" Click="SaveBtn_Click">حفظ</Button>
                <Button Width="100" Margin="8,0,0,0" Click="CancelBtn_Click">إلغاء</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
