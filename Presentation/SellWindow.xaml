<Window x:Class="Shop.Presentation.SellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيع" Height="280" Width="360" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="InvoiceLabel" FontWeight="Bold" FontSize="16" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="التاجر:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="MerchantBox" DisplayMemberPath="Name" Width="220" />
                <TextBlock Text="المكان:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="LocationBox" Width="180" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="AddLineBtn" Content="أضف بند" Width="100" Click="AddLineBtn_Click" />
            <Button x:Name="RemoveLineBtn" Content="حذف البند المحدد" Width="140" Margin="8,0,0,0" Click="RemoveLineBtn_Click" />
        </StackPanel>

        <DataGrid x:Name="LinesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridComboBoxColumn Header="الصنف" SelectedValueBinding="{Binding ItemId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="*" />
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, Mode=TwoWay}" Width="100" />
                <DataGridTextColumn Header="السعر" Binding="{Binding Price, Mode=TwoWay, StringFormat=N2}" Width="120" />
                <DataGridTextColumn Header="الملاحظة" Binding="{Binding Note, Mode=TwoWay}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="حفظ الفاتورة" Width="140" Margin="6" Click="SellBtn_Click" />
            <Button Content="إلغاء" Width="100" Margin="6" Click="CancelBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
