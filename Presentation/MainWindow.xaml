<Window x:Class="Shop.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول" Height="220" Width="380" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="تسجيل الدخول" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" />

            <StackPanel Orientation="Vertical" Width="320">
                <TextBlock Text="اسم المستخدم" Margin="4,0,0,2" />
                <TextBox x:Name="UsernameBox" Height="36" FontSize="15" />

                <TextBlock Text="كلمة السر" Margin="4,8,0,2" />
                <PasswordBox x:Name="PasswordBox" Height="36" FontSize="15" />
                <Button x:Name="ForgotBtn" Content="نسيت كلمة السر؟" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Width="140" Margin="0,8,0,0" Click="ForgotBtn_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="LoginBtn" Style="{StaticResource PrimaryButtonStyle}" Width="140" Click="LoginBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/icon_user.png" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="دخول" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CreateAccountBtn" Style="{StaticResource SecondaryButtonStyle}" Width="180" Click="CreateAccountBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/icon_user.png" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="انشاء حساب جديد" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="ExitBtn" Content="خروج" Width="100" HorizontalAlignment="Center" Margin="0,12,0,0" Click="ExitBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
