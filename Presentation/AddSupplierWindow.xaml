<Window x:Class="Shop.Presentation.AddSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مورد" Height="300" Width="420" FlowDirection="RightToLeft">
    <Grid Margin="12">
        <StackPanel Width="360" HorizontalAlignment="Center">
            <TextBlock Text="إضافة مورد جديد" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center" />

            <TextBlock Text="اسم المورد" />
            <TextBox x:Name="NameBox" />

            <TextBlock Text="الهاتف" Margin="0,8,0,0" />
            <TextBox x:Name="PhoneBox" />

            <TextBlock Text="المدينة" Margin="0,8,0,0" />
            <TextBox x:Name="LocationBox" />

            <TextBlock Text="العنوان" Margin="0,8,0,0" />
            <TextBox x:Name="AddressBox" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="SaveBtn_Click">حفظ</Button>
                <Button Width="120" Margin="8,0,0,0" Click="CancelBtn_Click">إلغاء</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
