<Window x:Class="Shop.Presentation.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة" Height="780" Width="620" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="PrintBtn" Width="120" Margin="6" Click="PrintBtn_Click">طباعة A4</Button>
            <Button x:Name="ExportPdfBtn" Width="140" Margin="6" Click="ExportPdfBtn_Click">تصدير PDF</Button>
            <Button Width="100" Margin="6" Click="CloseBtn_Click">إغلاق</Button>
        </StackPanel>

        <FlowDocumentScrollViewer x:Name="DocViewer" Grid.Row="1" />

        <TextBlock Grid.Row="2" Text="تأكد من اختيار الطابعة وحجم الصفحة A4 عند الطباعة." FontStyle="Italic" Margin="4" HorizontalAlignment="Left" />
    </Grid>
</Window>
