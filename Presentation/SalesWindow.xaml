<Window x:Class="Shop.Presentation.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المبيعات" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
            <Label Content="الشهر:" VerticalAlignment="Center" />
            <ComboBox x:Name="MonthCombo" Width="140" Margin="5,0" />
            <ComboBox x:Name="YearCombo" Width="100" Margin="5,0" />
            <Button x:Name="PrevMonthBtn" Content="السابق" Margin="5,0" Click="PrevMonthBtn_Click" />
            <Button x:Name="NextMonthBtn" Content="التالي" Margin="5,0" Click="NextMonthBtn_Click" />

            <TextBox x:Name="SearchBox" Width="220" Margin="15,0" />
            <Button Content="بحث" Margin="5,0" Click="SearchBtn_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExportPdfBtn" Content="تصدير تقرير PDF (A4)" Margin="10,0" Click="ExportPdfBtn_Click" />
                <Button x:Name="RefreshBtn" Content="تحديث" Margin="5,0" Click="RefreshBtn_Click" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Aggregated per-item totals for the selected month -->
            <GroupBox Header="ملخص مبيعات الشهر" Margin="0,0,10,0">
                <DataGrid x:Name="ItemTotalsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding TotalQuantity}" Width="120" />
                        <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalAmount}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Right: List of invoices for the month -->
            <GroupBox Grid.Column="1" Header="قائمة الفواتير" Margin="10,0,0,0">
                <DataGrid x:Name="InvoicesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="InvoicesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120" />
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="160" />
                        <DataGridTextColumn Header="التاجر" Binding="{Binding MerchantName}" Width="*" />
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="120" />
                        <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>